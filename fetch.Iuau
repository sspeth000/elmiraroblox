local UserInputService = game:GetService("UserInputService")

local isMobile =
	UserInputService.TouchEnabled
	and not UserInputService.KeyboardEnabled

local url = "https://raw.githubusercontent.com/sspeth000/elmiraroblox/main/panel.luau"

if isMobile then
	local source = game:HttpGet(url)
	loadstring(source)()
else
	warn("Not running on a mobile device.")
end
